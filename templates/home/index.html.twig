{% extends "base.html.twig" %}
{% block body %}
<section class="card py-16 text-center">
    <h1 class="page-title mb-4">Bienvenue sur mon application Symfony</h1>
    <p class="mb-8 text-lg text-slate-500">Explore les livres, les utilisateurs et les catégories 🎉</p>
    <div class="flex flex-wrap justify-center gap-3">
        <a href="{{ path('app_books') }}" class="btn">📚 Voir les livres</a>
        <a href="{{ path('app_profile') }}" class="btn-light">👤 Voir les utilisateurs</a>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {% for formation in formations %}
            <twig:FormationCard title="{{ formation.title }}" description="{{ formation.description }}" />
        {% else %}
            <p class="empty sm:col-span-2">Aucune formation disponible 😢</p>
        {% endfor %}

    </div>
</section>
{% endblock %}
