{% extends "base.html.twig" %}

{% block body %}
    <h1>Liste des livres</h1>
    <ul>
        {% for book in books %}
        {% if book is not empty %}   
             <li>
                <strong>{{ book.title }}</strong> - {{ book.author }} - 
                <a href="{{ path('app_book_show', {id: book.id}) }}">
                     Voir le détail
                </a>
            </li>
        {% else %}
                <li>Aucun livre disponible</li>
        {% endif %}
        {% endfor %}
    </ul>
{% endblock body %}
