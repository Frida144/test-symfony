{% extends 'base.html.twig' %}

{% block title %}Nouveau livre{% endblock %}

{% block body %}
    {% set input_class = 'mt-1 w-full rounded-full bg-white px-5 py-2 text-slate-700 shadow-sm ring-1 ring-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-400' %}
    {% set row_vars = {
        row_attr: {class: 'flex flex-col'},
        label_attr: {class: 'text-sm font-semibold text-violet-700'},
        error_item_class: 'mt-1 text-sm text-rose-600'
    } %}

    <section class="card mx-auto max-w-2xl">
        <h1 class="page-title mb-2 text-center">📚 Nouveau livre</h1>
        <p class="mb-6 text-center text-sm text-slate-500">Remplis les informations du livre</p>

        {{ form_start(form, {attr: {class: 'flex flex-col gap-5', novalidate: 'novalidate'}}) }}
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(form.title, row_vars|merge({
                    attr: {class: input_class, placeholder: 'Le titre du livre', autofocus: true}
                })) }}
                {{ form_row(form.author, row_vars|merge({
                    attr: {class: input_class, placeholder: 'Prénom Nom'}
                })) }}
            </div>

            {{ form_row(form.resume, row_vars|merge({
                attr: {class: 'mt-1 w-full rounded-3xl bg-white px-5 py-3 text-slate-700 shadow-sm ring-1 ring-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-400', rows: 4, placeholder: 'De quoi parle ce livre ? (255 caractères max)'}
            })) }}

            {{ form_row(form.publishAt, row_vars|merge({
                attr: {class: input_class ~ ' sm:w-1/2'}
            })) }}

            {# Catégories : une case à cocher par catégorie, affichées en étiquettes #}
            <fieldset class="flex flex-col">
                <legend class="mb-2 text-sm font-semibold text-violet-700">{{ form.categories.vars.label }}</legend>
                <div class="flex flex-wrap gap-2">
                    {% for choice in form.categories %}
                        <label class="flex cursor-pointer items-center gap-2 rounded-full bg-white px-3 py-1 text-sm text-violet-600 shadow-sm ring-1 ring-violet-200 transition hover:bg-violet-50 has-[:checked]:bg-violet-500 has-[:checked]:text-white">
                            {{ form_widget(choice, {attr: {class: 'h-4 w-4 accent-violet-500'}}) }}
                            {{ choice.vars.label }}
                        </label>
                    {% else %}
                        <p class="text-sm text-slate-400">Aucune catégorie — <a href="{{ path('app_category_new') }}" class="text-violet-600 underline">en créer une</a></p>
                    {% endfor %}
                </div>
                {{ form_errors(form.categories) }}
            </fieldset>

            <button type="submit" class="btn w-full justify-center py-3 text-base">Enregistrer le livre ✅</button>
        {{ form_end(form) }}

        <p class="mt-6 text-center">
            <a href="{{ path('app_books') }}" class="btn-light">← Retour à la liste</a>
        </p>
    </section>
{% endblock %}