{% extends 'base.html.twig' %}

{% block title %}Editer la catégorie{% endblock %}

{% block body %}
    {% set input_class = 'mt-1 w-full rounded-full bg-white px-5 py-2 text-slate-700 shadow-sm ring-1 ring-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-400' %}

    <section class="card mx-auto max-w-md">
        <h1 class="page-title mb-2 text-center">🏷️ Nouvelle catégorie</h1>
        <p class="mb-6 text-center text-sm text-slate-500">Ajoute une catégorie pour classer tes livres</p>

        {{ form_start(form, {attr: {class: 'flex flex-col gap-5', novalidate: 'novalidate'}}) }}
            {{ form_row(form.name, {
                row_attr: {class: 'flex flex-col'},
                label_attr: {class: 'text-sm font-semibold text-violet-700'},
                attr: {class: input_class, placeholder: 'Polar, Science-fiction…', autofocus: true},
                error_item_class: 'mt-1 text-sm text-rose-600'
            }) }}

            <button type="submit" class="btn w-full justify-center py-3 text-base">Modifier ✅</button>
        {{ form_end(form) }}

        <p class="mt-6 text-center">
            <a href="{{ path('app_categories') }}" class="btn-light">← Voir toutes les catégories</a>
        </p>
    </section>
{% endblock %}
