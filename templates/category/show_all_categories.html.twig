{% extends "base.html.twig" %}
{% block title %}
Liste des categories
{% endblock %}
{% block body %}
<section>
    {% if categories %}
    <h1 class="page-title">🏷️ Liste des categories</h1>
    <div class="flex flex-wrap gap-3">
        {# boucler sur la liste des categories #}
        {% for category in categories %}
        <twig:CategoryCard id="{{ category.id }}" name="{{ category.name }}" />
        {% endfor %}
    </div>
    {% else %}
    <h2 class="empty">La liste est vide 😢</h2>
    {% endif %}
</section>
{% endblock %}