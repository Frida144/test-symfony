{# templates/components/Alert.html.twig #}
{% props message, type = 'info' %}

{% set styles = {
    info:    {classes: 'bg-sky-100 text-sky-700 ring-sky-300',             icon: 'ℹ️'},
    success: {classes: 'bg-emerald-100 text-emerald-700 ring-emerald-300', icon: '✅'},
    warning: {classes: 'bg-amber-100 text-amber-700 ring-amber-300',       icon: '⚠️'},
    danger:  {classes: 'bg-rose-100 text-rose-700 ring-rose-300',          icon: '❌'},
} %}
{% set style = styles[type] ?? styles.info %}

<div class="mb-4 flex items-center gap-3 rounded-2xl px-5 py-3 font-semibold shadow-sm ring-1 {{ style.classes }}" role="alert">
    <span>{{ style.icon }}</span>
    {{ message }}
</div>
