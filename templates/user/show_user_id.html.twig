{% extends "base.html.twig" %}
{% block title %}
Détail de l'utilisateur
{% endblock %}
{% block body %}
<section>
    <h1 class="page-title">Détail de l'utilisateur</h1>
    <article class="card text-center">
        <div class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-pink-400 to-violet-500 text-3xl font-bold text-white">
            {{ user.firstname|first }}{{ user.lastname|first }}
        </div>
        <p class="text-2xl font-bold text-violet-700">{{ user.firstname }} {{ user.lastname }}</p>
        <p class="mb-2 text-slate-500">✉️ {{ user.email }}</p>
        <p class="mb-6 text-sm text-slate-400">id : {{ user.id }}</p>
        <a href="{{ path('app_profile') }}" class="btn-light">← Retour à la liste</a>
    </article>
</section>
{% endblock %}
